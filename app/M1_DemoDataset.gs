/**
 * M1_DemoDataset.gs · Member 1: load the fictional test dataset
 *
 * Registers the dataset's suppliers through the real Member 1 functions, uploads
 * their PDFs from a Drive folder, and fills the GroundTruth tab (the answer key).
 * The data itself is in M1_DemoDatasetData.gs, generated by dataset/build_dataset.py.
 *
 * How to run it:
 *   1. Upload the dataset/pdfs folder to Google Drive and copy the folder's ID.
 *   2. Project Settings > Script properties > add DATASET_FOLDER_ID with that ID.
 *   3. Run M1_importDemoDataset. BrightClean is left out so you can register it live
 *      in the demo. Use M1_importDemoDatasetWithBrightClean to load it as well.
 * Running it again skips suppliers already registered, and links any answer-key rows
 * whose documents have been uploaded since (for example BrightClean's, after the demo).
 */

function M1_importDemoDataset() {
  return M1_importDataset(M1_datasetFolderId(), { includeLiveDemo: false });
}

function M1_importDemoDatasetWithBrightClean() {
  return M1_importDataset(M1_datasetFolderId(), { includeLiveDemo: true });
}

function M1_datasetFolderId() {
  const id = PropertiesService.getScriptProperties().getProperty('DATASET_FOLDER_ID');
  if (!id) {
    throw new Error('Add a script property called DATASET_FOLDER_ID with the ID of the Drive folder that holds the dataset PDFs ' +
      '(Project Settings > Script properties).');
  }
  return id;
}

/**
 * options = { includeLiveDemo: false, includeRenewals: false }
 * includeRenewals also uploads the renewal PDF that is meant to be uploaded by hand in the demo.
 * Returns the report lines (also printed to the log).
 */
function M1_importDataset(folderId, options) {
  const opts = options || {};
  const folder = DriveApp.getFolderById(folderId);
  const files = {};
  const listing = folder.getFiles();
  while (listing.hasNext()) {
    const f = listing.next();
    files[f.getName()] = f;
  }

  const report = [];
  const supplierIds = {};
  const docIds = {};
  const existing = readTable(SEG.TABS.SUPPLIERS);
  existing.forEach((s) => { supplierIds[s.supplier_name] = s.supplier_id; });
  readTable(SEG.TABS.DOCUMENTS).forEach((d) => {
    if (d.original_file_name && !docIds[d.original_file_name]) docIds[d.original_file_name] = d.doc_id;
  });

  M1_DATASET.suppliers.forEach((s) => {
    const name = s.info.supplierName;
    if (s.liveDemo && !opts.includeLiveDemo) {
      report.push('Skipped ' + name + ': it is registered live in the demo.');
      return;
    }
    const already = existing.find((r) => SEG_cleanText(r.registration_no) === SEG_cleanText(s.info.registrationNo));
    if (already) {
      report.push('Skipped ' + name + ': already registered as ' + already.supplier_id + '.');
      return;
    }
    let detail = M1_saveSupplierDraft({ info: s.info, requirements: M1_datasetChecklist(s) });
    const id = detail.supplier.supplierId;
    supplierIds[name] = id;
    let uploaded = 0;
    s.documents.forEach((doc) => {
      if (doc.uploadLater && !opts.includeRenewals) return;
      const file = files[doc.fileName];
      if (!file) {
        report.push('  Not in the Drive folder: ' + doc.fileName);
        return;
      }
      const req = detail.requirements.find((r) => r.docTypeId === doc.docTypeId && (r.label || '') === (doc.label || ''));
      if (!req) {
        report.push('  No checklist item for ' + doc.docTypeId + ' at ' + name);
        return;
      }
      const blob = file.getBlob();
      const result = M1_uploadDocument({
        supplierId: id, requirementId: req.requirementId, fileName: doc.fileName,
        mimeType: blob.getContentType() || 'application/pdf', base64: Utilities.base64Encode(blob.getBytes())
      });
      docIds[doc.fileName] = result.docId;
      uploaded++;
    });
    detail = s.submit ? M1_registerSupplier(id) : M1_getSupplierDetail(id);
    report.push('Imported ' + name + ' as ' + id + ': ' + uploaded + ' document(s), status ' + detail.supplier.registrationStatus + '.');
  });

  const truthKey = (r) => (r.file_name === '(no file)' ? 'MISSING|' + r.supplier_name + '|' + r.document_type : r.file_name);
  const present = {};
  readTable(SEG.TABS.GROUND_TRUTH).forEach((r) => { present[truthKey(r)] = r; });
  const added = [];
  let linked = 0;
  M1_DATASET.groundTruth.forEach((g) => {
    const row = Object.assign({}, g, {
      supplier_id: supplierIds[g.supplier_name] || '',
      doc_id: g.file_name === '(no file)' ? '' : (docIds[g.file_name] || '')
    });
    const old = present[truthKey(g)];
    if (!old) {
      added.push(row);
      return;
    }
    const changes = {};
    if (!old.supplier_id && row.supplier_id) changes.supplier_id = row.supplier_id;
    if (!old.doc_id && row.doc_id) changes.doc_id = row.doc_id;
    if (Object.keys(changes).length) {
      updateRow(SEG.TABS.GROUND_TRUTH, old._row, changes);
      linked++;
    }
  });
  appendRows(SEG.TABS.GROUND_TRUTH, added);
  report.push('GroundTruth: ' + added.length + ' row(s) added, ' + linked + ' existing row(s) linked to new IDs.');

  SEG_audit({
    module: 'M1', action: 'DATASET_IMPORTED', recordType: 'SYSTEM', recordId: folderId, outcome: 'OK',
    reason: report.filter((line) => line.indexOf('Imported') === 0).length + ' supplier(s) imported. ' + report[report.length - 1]
  });
  console.log(report.join('\n'));
  return report;
}

/** The category's suggested checklist with this supplier's changes applied. */
function M1_datasetChecklist(supplier) {
  const list = M1_getCategoryChecklist(supplier.info.categoryId);
  (supplier.requirementOverrides || []).forEach((o) => {
    const item = list.find((r) => r.docTypeId === o.docTypeId);
    if (!item) return;
    if (o.mandatory !== undefined) item.mandatory = o.mandatory;
    if (o.reviewDate) item.reviewDate = o.reviewDate;
  });
  return list;
}
