/**
 * M1_DemoDataset.gs · Member 1: load the fictional test dataset
 *
 * Registers the dataset's suppliers through the real Member 1 functions, uploads
 * their PDFs from a Drive folder, and fills the GroundTruth tab (the answer key).
 * The data itself is in M1_DemoDatasetData.gs, generated by dataset/build_dataset.py.
 *
 * How to run it:
 *   1. Drag the project's test-pdfs folder into My Drive (keep its name).
 *   2. Run M1_importDemoDataset. It finds the folder by name and reads every sub-folder.
 *      BrightClean is left out so you can register it live in the video.
 *      Use M1_importDemoDatasetWithBrightClean to load it as well.
 *   Only if Drive has more than one "test-pdfs" folder: add a script property
 *   DATASET_FOLDER_ID with the ID of the right one (Project Settings > Script properties).
 * Running it again skips suppliers already registered, and links any answer-key rows
 * whose documents have been uploaded since (for example BrightClean's, after the demo).
 * To record the video again, run M1_resetVideoDemo: it removes BrightClean only.
 */

const M1_DATASET_FOLDER_NAME = 'test-pdfs';

function M1_importDemoDataset() {
  return M1_importDataset(M1_datasetFolderId(), { includeLiveDemo: false });
}

function M1_importDemoDatasetWithBrightClean() {
  return M1_importDataset(M1_datasetFolderId(), { includeLiveDemo: true });
}

/** The DATASET_FOLDER_ID script property if set, otherwise the one Drive folder called "test-pdfs". */
function M1_datasetFolderId() {
  const id = PropertiesService.getScriptProperties().getProperty('DATASET_FOLDER_ID');
  if (id) return id;
  const found = [];
  const folders = DriveApp.getFoldersByName(M1_DATASET_FOLDER_NAME);
  while (folders.hasNext()) {
    const f = folders.next();
    if (!f.isTrashed()) found.push(f);
  }
  if (found.length === 1) return found[0].getId();
  if (!found.length) {
    throw new Error('No "' + M1_DATASET_FOLDER_NAME + '" folder in Google Drive yet. Drag the project’s ' + M1_DATASET_FOLDER_NAME +
      ' folder into My Drive (keep its name), then run this again.');
  }
  throw new Error('Google Drive has ' + found.length + ' folders called "' + M1_DATASET_FOLDER_NAME + '". Delete the extra copies, or add a ' +
    'script property DATASET_FOLDER_ID with the ID of the right one (Project Settings > Script properties).');
}

/** Every file in the folder and all its sub-folders, by name. Files in the bin are skipped. */
function M1_datasetFiles(folder, files, duplicates) {
  const list = folder.getFiles();
  while (list.hasNext()) {
    const f = list.next();
    if (f.isTrashed()) continue;
    if (files[f.getName()]) duplicates.push(f.getName());
    else files[f.getName()] = f;
  }
  const subFolders = folder.getFolders();
  while (subFolders.hasNext()) {
    const sub = subFolders.next();
    if (!sub.isTrashed()) M1_datasetFiles(sub, files, duplicates);
  }
  return files;
}

/**
 * TESTING ONLY, run by hand: starts the demo data again from scratch, numbered from SUP001.
 * Removes every supplier from the test dataset (BrightClean too) and any TEST supplier, with
 * their documents and history (their Drive folders go to the bin), then imports the dataset
 * again from the test-pdfs folder. Suppliers you registered yourself are kept.
 */
function M1_restartDemoData() {
  const regNos = M1_DATASET.suppliers.map((s) => SEG_cleanText(s.info.registrationNo));
  const isTest = (s) => /^TEST /.test(String(s.supplier_name)) && /^TEST-/.test(String(s.registration_no));
  // Check the PDFs are reachable first, so a missing folder can't leave you with nothing.
  M1_datasetFolderId();
  M1_removeSuppliersForTesting((s) => regNos.indexOf(SEG_cleanText(s.registration_no)) >= 0 || isTest(s), 'demo', true);
  readTable(SEG.TABS.GROUND_TRUTH)
    .filter((r) => r.supplier_id || r.doc_id)
    .forEach((r) => updateRow(SEG.TABS.GROUND_TRUTH, r._row, { supplier_id: '', doc_id: '' }));
  return M1_importDemoDataset();
}

/**
 * TESTING ONLY, run by hand: removes BrightClean (the supplier registered live in the video)
 * and everything recorded about it, so the video can be recorded again. Its Drive folder goes
 * to the bin. The answer-key rows stay and are linked again after the next registration.
 */
function M1_resetVideoDemo() {
  const demo = M1_DATASET.suppliers.filter((s) => s.liveDemo);
  const regNos = demo.map((s) => SEG_cleanText(s.info.registrationNo));
  const names = demo.map((s) => s.info.supplierName);
  const removed = M1_removeSuppliersForTesting((s) => regNos.indexOf(SEG_cleanText(s.registration_no)) >= 0, 'video demo');
  readTable(SEG.TABS.GROUND_TRUTH)
    .filter((r) => names.indexOf(r.supplier_name) >= 0 && (r.supplier_id || r.doc_id))
    .forEach((r) => updateRow(SEG.TABS.GROUND_TRUTH, r._row, { supplier_id: '', doc_id: '' }));
  console.log(removed ? 'Ready to record again: ' + names.join(', ') + ' removed.' : 'Nothing to reset: ' + names.join(', ') + ' is not registered.');
  return removed;
}

/**
 * options = { includeLiveDemo: false, includeRenewals: false }
 * includeRenewals also uploads the renewal PDF that is meant to be uploaded by hand in the demo.
 * Returns the report lines (also printed to the log).
 */
function M1_importDataset(folderId, options) {
  const opts = options || {};
  let folder;
  try {
    folder = DriveApp.getFolderById(folderId);
  } catch (err) {
    throw new Error('The dataset folder (' + folderId + ') can’t be opened. If DATASET_FOLDER_ID is set in Script properties, check it, ' +
      'or delete it so the "' + M1_DATASET_FOLDER_NAME + '" folder is found by name.');
  }
  if (folder.isTrashed()) {
    throw new Error('The dataset folder "' + folder.getName() + '" is in the Google Drive bin. Restore it, or drag ' + M1_DATASET_FOLDER_NAME +
      ' into My Drive again (and delete DATASET_FOLDER_ID from Script properties if you set it). Nothing was imported.');
  }
  const duplicates = [];
  const files = M1_datasetFiles(folder, {}, duplicates);

  // Check every PDF is there BEFORE registering anyone. Otherwise a run made while Drive is still
  // uploading would register suppliers with no documents, and a second run would skip them.
  const registeredNos = readTable(SEG.TABS.SUPPLIERS).map((r) => SEG_cleanText(r.registration_no));
  const absent = [];
  M1_DATASET.suppliers.forEach((s) => {
    if (s.liveDemo && !opts.includeLiveDemo) return;
    if (registeredNos.indexOf(SEG_cleanText(s.info.registrationNo)) >= 0) return;
    s.documents.forEach((doc) => {
      if (doc.uploadLater && !opts.includeRenewals) return;
      if (!files[doc.fileName]) absent.push(doc.fileName);
    });
  });
  if (absent.length) {
    throw new Error(absent.length + ' PDF(s) are not in the "' + folder.getName() + '" folder yet: ' + absent.join(', ') +
      '. If you just dragged the folder into Drive, wait until the upload finishes, then run this again. Nothing was imported.');
  }

  const report = [];
  if (duplicates.length) report.push('Found more than one file called: ' + duplicates.join(', ') + '. The first one found was used.');
  const supplierIds = {};
  const docIds = {};
  const existing = readTable(SEG.TABS.SUPPLIERS);
  existing.forEach((s) => { supplierIds[s.supplier_name] = s.supplier_id; });
  readTable(SEG.TABS.DOCUMENTS).forEach((d) => {
    if (d.original_file_name && !docIds[d.original_file_name]) docIds[d.original_file_name] = d.doc_id;
  });

  M1_DATASET.suppliers.forEach((s) => {
    const name = s.info.supplierName;
    if (s.liveDemo && !opts.includeLiveDemo) {
      report.push('Skipped ' + name + ': it is registered live in the demo.');
      return;
    }
    const already = existing.find((r) => SEG_cleanText(r.registration_no) === SEG_cleanText(s.info.registrationNo));
    if (already) {
      report.push('Skipped ' + name + ': already registered as ' + already.supplier_id + '.');
      return;
    }
    let detail = M1_saveSupplierDraft({ info: s.info, requirements: M1_datasetChecklist(s) });
    const id = detail.supplier.supplierId;
    supplierIds[name] = id;
    let uploaded = 0;
    s.documents.forEach((doc) => {
      if (doc.uploadLater && !opts.includeRenewals) return;
      const file = files[doc.fileName];
      if (!file) {
        report.push('  Not in the Drive folder: ' + doc.fileName);
        return;
      }
      const req = detail.requirements.find((r) => r.docTypeId === doc.docTypeId && (r.label || '') === (doc.label || ''));
      if (!req) {
        report.push('  No checklist item for ' + doc.docTypeId + ' at ' + name);
        return;
      }
      const blob = file.getBlob();
      const result = M1_uploadDocument({
        supplierId: id, requirementId: req.requirementId, fileName: doc.fileName,
        mimeType: blob.getContentType() || 'application/pdf', base64: Utilities.base64Encode(blob.getBytes())
      });
      docIds[doc.fileName] = result.docId;
      uploaded++;
    });
    detail = s.submit ? M1_registerSupplier(id) : M1_getSupplierDetail(id);
    report.push('Imported ' + name + ' as ' + id + ': ' + uploaded + ' document(s), status ' + detail.supplier.registrationStatus + '.');
  });

  const truthKey = (r) => (r.file_name === '(no file)' ? 'MISSING|' + r.supplier_name + '|' + r.document_type : r.file_name);
  const present = {};
  readTable(SEG.TABS.GROUND_TRUTH).forEach((r) => { present[truthKey(r)] = r; });
  const added = [];
  let linked = 0;
  M1_DATASET.groundTruth.forEach((g) => {
    const row = Object.assign({}, g, {
      supplier_id: supplierIds[g.supplier_name] || '',
      doc_id: g.file_name === '(no file)' ? '' : (docIds[g.file_name] || '')
    });
    const old = present[truthKey(g)];
    if (!old) {
      added.push(row);
      return;
    }
    const changes = {};
    if (!old.supplier_id && row.supplier_id) changes.supplier_id = row.supplier_id;
    if (!old.doc_id && row.doc_id) changes.doc_id = row.doc_id;
    if (Object.keys(changes).length) {
      updateRow(SEG.TABS.GROUND_TRUTH, old._row, changes);
      linked++;
    }
  });
  appendRows(SEG.TABS.GROUND_TRUTH, added);
  report.push('GroundTruth: ' + added.length + ' row(s) added, ' + linked + ' existing row(s) linked to new IDs.');
  SEG_fitColumns();

  SEG_audit({
    module: 'M1', action: 'DATASET_IMPORTED', recordType: 'SYSTEM', recordId: folderId, outcome: 'OK',
    reason: report.filter((line) => line.indexOf('Imported') === 0).length + ' supplier(s) imported. ' + report[report.length - 1]
  });
  console.log(report.join('\n'));
  return report;
}

/** The category's suggested checklist with this supplier's changes applied. */
function M1_datasetChecklist(supplier) {
  const list = M1_getCategoryChecklist(supplier.info.categoryId);
  (supplier.requirementOverrides || []).forEach((o) => {
    const item = list.find((r) => r.docTypeId === o.docTypeId);
    if (!item) return;
    if (o.mandatory !== undefined) item.mandatory = o.mandatory;
    if (o.reviewDate) item.reviewDate = o.reviewDate;
  });
  return list;
}
